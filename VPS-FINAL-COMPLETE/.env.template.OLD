# ========================================
# KAYEE01 VPS DEPLOYMENT CONFIGURATION
# ========================================

# CRITICAL: Your domain name (REQUIRED)
DOMAIN_NAME=kayee01.com

# CRITICAL: MongoDB password (CHANGE THIS!)
MONGO_PASSWORD=YourSecureMongoPassword123!

# JWT Secret (will be auto-generated by DEPLOY.sh)
JWT_SECRET_KEY=

# ========================================
# EMAIL CONFIGURATION (REQUIRED)
# ========================================
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Email sender info
FROM_EMAIL=kayicom509@gmail.com
FROM_NAME=Kayee01

# ========================================
# PAYMENT GATEWAYS (REQUIRED for payments)
# ========================================

# Stripe (for credit card payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Plisio (for crypto payments)
PLISIO_API_KEY=your_plisio_api_key_here

# ========================================
# ADVANCED SETTINGS (Optional)
# ========================================

# Admin emails (CHANGE to your admin emails)
ADMIN_EMAIL_1=kayicom509@gmail.com
ADMIN_EMAIL_2=Info.kayicom.com@gmx.fr

# Database name (default: kayee01_db)
DB_NAME=kayee01_db

# SMTP settings (pre-configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ========================================
# DO NOT MODIFY BELOW THIS LINE
# ========================================
# These are automatically set by the deployment scripts
FRONTEND_URL=https://${DOMAIN_NAME}
BACKEND_URL=https://${DOMAIN_NAME}
CORS_ORIGINS=https://${DOMAIN_NAME},http://${DOMAIN_NAME}
