# Production environment (Vercel env var REACT_APP_BACKEND_URL overrides this when set)
REACT_APP_BACKEND_URL=https://api.kayee01.com
# Empty so CRA replaces %REACT_APP_…% with "" instead of leaving the literal placeholder.
# Override on Vercel with your real Google/Bing verification tokens when using HTML tags.
REACT_APP_GOOGLE_SITE_VERIFICATION=
REACT_APP_BING_SITE_VERIFICATION=
